{
  "name": "boim-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run prepare-pdf && npm run prepare-dart && next dev",
    "build": "npm run prepare-pdf && npm run prepare-dart && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"lib/**/*.test.ts\"",
    "prepare-pdf": "node scripts/copy-pdf-assets.mjs",
    "prepare-dart": "node scripts/build-dart-index.mjs"
  },
  "dependencies": {
    "next": "16.2.11",
    "onnxruntime-web": "^1.29.0",
    "openai": "^7.4.0",
    "pdfjs-dist": "^6.2.108",
    "ppu-paddle-ocr": "^6.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5"
  }
}
